rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Global deny-all fallback ──────────────────────────────────────
    // Any path not explicitly matched below is denied. Firestore already
    // denies by default, but being explicit prevents accidental exposure
    // if new collections are added before rules are written for them.
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Trails (public catalogue) ─────────────────────────────────────
    // Anyone can browse trails; only callers with the `admin` custom claim
    // (set server-side via Firebase Admin SDK) can create, update, or delete.
    match /trails/{trailId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── App config (e.g. community WhatsApp invite link) ───────────────
    // Any signed-in user may read config docs (the onboarding success screen
    // needs the WhatsApp link right after sign-in); only admins can rotate
    // values, so the link can change without a redeploy.
    match /config/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // ── User profiles ─────────────────────────────────────────────────
    // A user may only read or write their own document. Create writes are
    // validated to prevent storing arbitrary fields. Updates only validate
    // the keys actually being changed (affectedKeys) so that existing
    // documents with legacy fields (e.g. uid from old auth code) never
    // cause a permanent 403 that locks the user out of the app.
    match /users/{userId} {
      allow read:   if isOwner(userId);
      allow create: if isOwner(userId) && validUserProfile();
      allow update: if isOwner(userId) && validUserProfileUpdate();
      allow delete: if isOwner(userId);

      // ── Service history subcollection ─────────────────────────────
      match /serviceHistory/{recordId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ── Repair history subcollection ──────────────────────────────
      match /repairHistory/{recordId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ── Ride logs subcollection ───────────────────────────────────
      // Ride logs are private to the owning user. Both required and optional
      // fields are validated on write.
      match /rides/{rideId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId) && validRideLog();
        allow update: if isOwner(userId) && validRideLog();
        allow delete: if isOwner(userId);
      }
    }

    // ── Helper functions ──────────────────────────────────────────────

    // True when the caller holds an `admin` custom claim set via Admin SDK.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // True when the caller is authenticated and owns the document path.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Fields writable on a user's own profile document. Includes the
    // onboarding-survey fields (Q1-Q14) alongside the pre-existing app
    // fields; `surveyCompletedAt` is the marker that gates re-entry to
    // /join (see OnboardingService).
    function userProfileFields() {
      return ['displayName', 'email', 'photoURL', 'lastSeen',
              'riddenTrails', 'notes', 'preferences', 'createdAt',
              'bikeData', 'stravaConnection',
              'whatsappNumber', 'referralSource', 'referralMemberName',
              'referralOther', 'ridingTenure', 'ridingFrequency', 'bike',
              'trailsRiddenIds', 'scenarioDescent', 'scenarioEndurance',
              'scenarioAir', 'disciplineLeaning', 'goals',
              'emergencyContactName', 'emergencyContactNumber',
              'surveyCompletedAt'];
    }

    // Validates user-profile creates — only known fields are permitted so
    // arbitrary data cannot be stored in brand-new user documents.
    function validUserProfile() {
      return request.resource.data.keys().hasOnly(userProfileFields());
    }

    // Validates user-profile updates — checks only the keys being changed,
    // not the full document. This prevents legacy fields (e.g. uid written
    // by old auth code) from causing permanent 403 errors on existing accounts.
    function validUserProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(userProfileFields());
    }

    // Validates ride-log writes — trailId, trailName, date, verificationMethod,
    // and loggedAt are required; no fields outside the allowed set are accepted.
    function validRideLog() {
      let required = ['trailId', 'trailName', 'date', 'verificationMethod', 'loggedAt'];
      let allowed  = ['trailId', 'trailName', 'date', 'distanceKm', 'durationMinutes',
                      'elevationM', 'note', 'verificationMethod', 'screenshotStoragePath',
                      'aiRawExtraction', 'aiConfidence', 'loggedAt'];
      return request.resource.data.keys().hasAll(required)
          && request.resource.data.keys().hasOnly(allowed);
    }
  }
}
